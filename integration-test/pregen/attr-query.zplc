# -*- mode: toml -*-
# oidc + zpr-attr/1 interplay integration-test fixture config (zipline#81;
# ported to Zodes by zl-zipline#234), used by attr-query-test.sh.
#
# zodes-pair.zplc's layout (the relay Zode docks the visa service and is
# linked to Zodes zb and zc) with oidc-file-interplay.zplc's trusted
# services, the `happyfile` file store replaced by the `zipline` zpr-attr/1
# attribute service (mirrors the compiler fixture test-attr-query.zplc,
# zipline#76):
#   - `google` (api = "oidc") is the fake IdP the test runs on each
#     namespace's loopback (issuer, client_id, seed JWKS).
#   - `zipline` (api = "zpr-attr/1") decorates on google's identity
#     attribute: the test runs the reference zpr-attr-server on the relay
#     namespace's loopback, next to the visa service, TLS-pinned to the
#     pregen test CA (ca-cert.pem), authenticated by the bearer token the
#     vs reads from ts_secrets_dir/zipline.token. expiration_seconds = 90
#     deliberately exceeds the vs's 60 s MIN_ATTRIBUTE_TTL while keeping
#     any TTL-derived wait in the test bounded.
#
# `service` (the JWKS CONNECT proxy) is deliberately omitted — the visa
# service fetches the JWKS directly — so zplc emits a warning; expected.

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"relay.zpr" = "fd5a:5052::2"
"zb.zpr" = "fd5a:5052::3"
"zc.zpr" = "fd5a:5052::4"

[nodes.relay]
provider = [ [ "device.zpr.adapter.cn", "relay" ] ]
zpr_address = "relay.zpr"
transit = true

[nodes.relay.substrate_addrs]
i0 = "10.2.0.1:5000"

# No substrate_addrs for zb and zc (zl-zipline#255): the visa service
# learns their addresses from what they report when they connect.
[nodes.zb]
provider = [ [ "device.zpr.adapter.cn", "zb" ] ]
zpr_address = "zb.zpr"

[nodes.zc]
provider = [ [ "device.zpr.adapter.cn", "zc" ] ]
zpr_address = "zc.zpr"

[links.relay-zb]
peers = [ { node = "relay" }, { node = "zb" } ]

[links.relay-zc]
peers = [ { node = "relay" }, { node = "zc" } ]

[trusted_services.default]
cert_path = "ca-cert.pem"

[trusted_services.zipline]
api = "zpr-attr/1"
url = "https://127.0.0.1:8443/"
ca_cert_path = "ca-cert.pem"
timeout_seconds = 5
expiration_seconds = 90
returns_attributes = ["dept -> user.dept", "contractor -> #user.contractor"]

[trusted_services.google]
api             = "oidc"
issuer          = "https://127.0.0.1:9000"
jwks_uri        = "https://127.0.0.1:9000/jwks"
client_id       = "zpr-test-client"
scopes          = ["openid", "email", "profile"]
allowed_domains = ["example.com"]
seed_jwks       = "oidc-test-seed-jwks.json"

expiration_seconds   = 43200
max_auth_age_seconds = 86400
allow_offline_access = false

returns_attributes = [
  "sub   -> user.sub",
  "email -> user.email",
]
identity_attributes = ["sub"]

[visa_service]
dock_node = "relay"

[bootstrap]
"relay" = "node-rsa-pubkey.pem"
"zb" = "zb-rsa-pubkey.pem"
"zc" = "zc-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.Web]
protocol = "ping"
provider = [["device.zpr.adapter.cn", "zc"]]

[services.PingableVs]
protocol = "ping"
