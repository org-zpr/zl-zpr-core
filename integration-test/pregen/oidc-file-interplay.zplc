# -*- mode: toml -*-
#
# oidc + file interplay netns fixture (zipline#27), used by
# oidc-file-interplay-test.sh. zodes-login.zplc's relay and zb, with the
# two trusted services of zipline#22 (rationale:
# zl-zpr-dev-context/docs/VISA_SERVICE.md, "Design decisions"):
#   - `google` (api = "oidc") is the compiler fixture
#     test-oidc-file-interplay.zplc's service re-pinned to the fake IdP the
#     test runs on each namespace's loopback (issuer, client_id, seed JWKS).
#   - `happyfile` (api = "file") decorates on google's identity attribute;
#     the visa service loads its data from file_ts_dir/happyfile.json, keyed
#     on user.sub. expiration_seconds = 90 deliberately exceeds the visa
#     service's 60 s MIN_ATTRIBUTE_TTL while keeping the test's refresh leg
#     short.
#
# `service` (the JWKS CONNECT proxy) is omitted, as in zodes-login.zplc, so
# zplc warns; expected.

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"relay.zpr" = "fd5a:5052::2"
"zb.zpr" = "fd5a:5052::3"

[nodes.relay]
provider = [ [ "device.zpr.adapter.cn", "relay" ] ]
zpr_address = "relay.zpr"
transit = true

[nodes.relay.substrate_addrs]
i0 = "10.2.0.1:5000"

[nodes.zb]
provider = [ [ "device.zpr.adapter.cn", "zb" ] ]
zpr_address = "zb.zpr"

[links.relay-zb]
peers = [ { node = "relay" }, { node = "zb" } ]

[trusted_services.default]
cert_path = "ca-cert.pem"

[trusted_services.happyfile]
api = "file"
returns_attributes = ["hair_color -> user.hair_color", "lazy -> #user.lazy"]
expiration_seconds = 90

[trusted_services.google]
api             = "oidc"
issuer          = "https://127.0.0.1:9000"
jwks_uri        = "https://127.0.0.1:9000/jwks"
client_id       = "zpr-test-client"
scopes          = ["openid", "email", "profile"]
allowed_domains = ["example.com"]
seed_jwks       = "oidc-test-seed-jwks.json"

# The login outlives the run, so no renewal is needed: the test logs in
# with `ph-cli connect`, which leaves no agent behind.
expiration_seconds   = 43200
max_auth_age_seconds = 86400
allow_offline_access = false

returns_attributes = [
  "sub   -> user.sub",
  "email -> user.email",
]
identity_attributes = ["sub"]

[visa_service]
dock_node = "relay"

[bootstrap]
"relay" = "node-rsa-pubkey.pem"
"zb" = "zb-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.Web]
protocol = "ping"
provider = [["device.zpr.adapter.cn", "relay"]]

[services.PingableVs]
protocol = "ping"
