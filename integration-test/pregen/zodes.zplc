# -*- mode: toml -*-
#
# Zode links netns fixture (zl-zipline#250), used by zode-link-test.sh
# through lib/zode_funcs.sh. The relay Zode docks the visa service and is
# linked to Zode zb, so the relay's topology names zb (CN zb), with no peer
# address until zb connects and reports one (zl-zipline#255). A third Zode,
# zc, is signed by the same CA but is in no policy: the relay must refuse it.
#
# All Zodes share one substrate segment (a bridge in the relay's
# namespace); the addresses below match lib/zode_funcs.sh.

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"relay.zpr" = "fd5a:5052::2"
"zb.zpr" = "fd5a:5052::3"

[nodes.relay]
provider = [ [ "device.zpr.adapter.cn", "relay" ] ]
zpr_address = "relay.zpr"
transit = true

[nodes.relay.substrate_addrs]
i0 = "10.2.0.1:5000"

[nodes.zb]
provider = [ [ "device.zpr.adapter.cn", "zb" ] ]
zpr_address = "zb.zpr"
# No substrate_addrs for zb (zl-zipline#255, W10): the visa service learns
# zb's address only from what zb reports when it connects.

[links.relay-zb]
peers = [ { node = "relay" }, { node = "zb" } ]

[trusted_services.default]
cert_path = "ca-cert.pem"

[visa_service]
dock_node = "relay"

[bootstrap]
"relay" = "node-rsa-pubkey.pem"
"zb" = "zb-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.PingableVs]
protocol = "ping"

[services.PingableRelay]
protocol = "ping"

[services.PingableZb]
protocol = "ping"
